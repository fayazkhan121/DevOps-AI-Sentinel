# Copy this file to .env and fill in secrets. Never commit .env.

JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-a-long-random-string
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
SQLITE_PATH=data/sentinel.db
DATABASE_TYPE=sqlite
METRICS_RETENTION_DAYS=90

# Postgres (optional; set DATABASE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devops_sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# TLS termination via docker compose --profile tls
TLS_CERT_PATH=
TLS_KEY_PATH=

# Vite (optional; default is to proxy /api)
VITE_API_URL=/api

# Optional cloud / tool credentials (also configurable in Settings)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT_ID=
GCP_ACCESS_TOKEN=

KUBE_API_SERVER=
KUBE_TOKEN=
DOCKER_HOST=
JENKINS_URL=
JENKINS_USERNAME=
JENKINS_API_TOKEN=
GITHUB_TOKEN=
GITHUB_ORGANIZATION=
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DevOps AI Sentinel <noreply@localhost>
SLACK_WEBHOOK_URL=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:3000/api/auth/oidc/callback
OIDC_SCOPE=openid email profile

SAML_IDP_SSO_URL=
SAML_IDP_CERT=
SAML_ENTITY_ID=https://sentinel.local/saml
SAML_ACS_URL=http://localhost:3000/api/auth/saml/acs

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

METRICS_COLLECTION_INTERVAL=30
CPU_CRITICAL_THRESHOLD=90
MEMORY_CRITICAL_THRESHOLD=95
DISK_CRITICAL_THRESHOLD=95
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
