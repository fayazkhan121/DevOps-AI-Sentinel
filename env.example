# DevOps AI Sentinel - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# ===================================================================
# AWS CREDENTIALS
# ===================================================================
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# ===================================================================
# AZURE CREDENTIALS
# ===================================================================
# Create an App Registration in Azure AD
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id

# ===================================================================
# GOOGLE CLOUD CREDENTIALS
# ===================================================================
# Create a Service Account in GCP Console
GCP_PROJECT_ID=your_gcp_project_id
GCP_SERVICE_ACCOUNT_KEY_PATH=path/to/your/service-account-key.json

# ===================================================================
# KUBERNETES CONFIGURATION
# ===================================================================
# Path to your kubeconfig file
KUBE_CONFIG_PATH=~/.kube/config
KUBE_CONTEXT=your_cluster_context
KUBE_NAMESPACE=default

# ===================================================================
# DATABASE CONNECTIONS
# ===================================================================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=monitoring
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# MongoDB
MONGODB_URI=mongodb://localhost:27017/monitoring

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ===================================================================
# EMAIL/SMTP CONFIGURATION
# ===================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=DevOps AI Sentinel <noreply@yourcompany.com>

# ===================================================================
# SLACK INTEGRATION
# ===================================================================
# Create a Slack App and get these tokens
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#alerts

# ===================================================================
# DOCKER CONFIGURATION
# ===================================================================
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_PORT=2375
DOCKER_TLS=false

# ===================================================================
# JENKINS CONFIGURATION
# ===================================================================
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=your_jenkins_user
JENKINS_API_TOKEN=your_jenkins_api_token

# ===================================================================
# GIT PLATFORM INTEGRATIONS
# ===================================================================
# GitHub
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_ORGANIZATION=your_org_or_username

# GitLab
GITLAB_TOKEN=glpat-your_gitlab_access_token
GITLAB_URL=https://gitlab.com
GITLAB_GROUP_ID=your_group_id

# Bitbucket
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password
BITBUCKET_WORKSPACE=your_workspace

# ===================================================================
# SECURITY & ENCRYPTION
# ===================================================================
JWT_SECRET=your_super_secret_jwt_key_here
ENCRYPTION_KEY=your_32_character_encryption_key
SESSION_SECRET=your_session_secret_key

# ===================================================================
# MONITORING CONFIGURATION
# ===================================================================
# Metric collection intervals (in seconds)
METRICS_COLLECTION_INTERVAL=30
HEALTH_CHECK_INTERVAL=60
COST_ANALYSIS_INTERVAL=3600

# Alert thresholds
CPU_WARNING_THRESHOLD=70
CPU_CRITICAL_THRESHOLD=90
MEMORY_WARNING_THRESHOLD=80
MEMORY_CRITICAL_THRESHOLD=95
DISK_WARNING_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=95

# ===================================================================
# APPLICATION CONFIGURATION
# ===================================================================
NODE_ENV=production
PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# Database for application data
DATABASE_TYPE=indexeddb
# Options: indexeddb, localStorage, memory

# Enable/disable features
ENABLE_REAL_TIME_MONITORING=true
ENABLE_CLOUD_MONITORING=true
ENABLE_DEVOPS_MONITORING=true
ENABLE_SECURITY_MONITORING=true
ENABLE_COST_MONITORING=true
ENABLE_EMAIL_ALERTS=true
ENABLE_SLACK_ALERTS=true

# ===================================================================
# ADVANCED CONFIGURATION
# ===================================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
CORS_ORIGIN=http://localhost:5173

# Timezone for scheduling and reporting
TIMEZONE=UTC